{"name":"AI Image Manipulation Pipeline","nodes":[{"id":"watcher","name":"Cloud Storage Watcher","type":"@n8n/n8n-nodes-base.watchForFile","position":[250,300],"parameters":{"watchFolder":"={{ $env.IMAGE_INPUT_DIR }}"}},{"id":"preprocess","name":"Pre-process (Sharp)","type":"@n8n/n8n-nodes-base.code","position":[450,300],"parameters":{"jsCode":"const sharp=require('sharp');const b=Buffer.from($input.first().binary.data,'base64');const r=await sharp(b).resize(1024,1024,{fit:'inside'}).toBuffer();return[{binary:{data:r.toString('base64')},filename:$input.first().binary.fileName}];"}},{"id":"replicate","name":"Replicate API","type":"@n8n/n8n-nodes-base.httpRequest","position":[650,300],"parameters":{"method":"POST","url":"https://api.replicate.com/v1/predictions","authentication":"genericCredentialType","genericAuthType":"bearerAuth","sendHeaders":true,"headerParameters":{"parameters":[{"name":"Authorization","value":"Bearer {{ $env.REPLICATE_API_KEY }}"}]},"sendBody":true,"contentType":"application/json","bodyParameters":{"parameters":[{"name":"version","value":"={{ $env.REPLICATE_SDXL_VERSION }}"},{"name":"input","value":{"image":"={{ $json.buffer }}","prompt":"={{ $env.DEFAULT_IMAGE_PROMPT }}"}}]}}},{"id":"postprocess","name":"Post-process (compress)","type":"@n8n/n8n-nodes-base.code","position":[850,300],"parameters":{"jsCode":"const sharp=require('sharp');const b=Buffer.from($input.first().binary.data,'base64');const c=await sharp(b).jpeg({quality:85}).toBuffer();return[{binary:{data:c.toString('base64')}}];"}},{"id":"s3","name":"Upload to S3","type":"@n8n/n8n-nodes-base.awsS3","position":[1050,300],"parameters":{"operation":"upload","bucket":"={{ $env.S3_BUCKET }}","fileName":"processed/{{ $now }}.jpg","binaryData":true}}],"connections":{"watcher":{"main":[[{"node":"preprocess","type":"main","index":0}]]},"preprocess":{"main":[[{"node":"replicate","type":"main","index":0}]]},"replicate":{"main":[[{"node":"postprocess","type":"main","index":0}]]},"postprocess":{"main":[[{"node":"s3","type":"main","index":0}]]}}}
