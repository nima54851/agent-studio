{"name":"Automated Release Notes Pipeline","nodes":[{"id":"webhook","name":"GitHub Webhook","type":"@n8n/n8n-nodes-base.webhook","position":[250,300]},{"id":"fetch","name":"GitHub API (commits)","type":"@n8n/n8n-nodes-base.github","position":[450,300],"parameters":{"operation":"getRepository","repository":"={{ $json.repository.full_name }}"}},{"id":"classify","name":"AI: Classify Changes","type":"@n8n/n8n-nodes-base.openAi","position":[650,300],"parameters":{"resource":"chat","prompt":"Classify commits into categories (feat/fix/docs/refactor/test/perf). Return JSON array.\n{{ $json.commits }}","options":{"maxTokens":1000}}},{"id":"generate","name":"LLM: Generate Release Notes","type":"@n8n/n8n-nodes-base.openAi","position":[850,300],"parameters":{"resource":"chat","prompt":"Generate GitHub Release note in markdown:\n{{ $json.classified }}","options":{"maxTokens":800}}},{"id":"release","name":"GitHub: Create Release","type":"@n8n/n8n-nodes-base.github","position":[1050,300],"parameters":{"operation":"createRelease","tagName":"={{ $json.new_version }}","releaseName":"={{ $json.new_version }}","body":"={{ $json.release_notes }}"}}],"connections":{"webhook":{"main":[[{"node":"fetch","type":"main","index":0}]]},"fetch":{"main":[[{"node":"classify","type":"main","index":0}]]},"classify":{"main":[[{"node":"generate","type":"main","index":0}]]},"generate":{"main":[[{"node":"release","type":"main","index":0}]]}}}
