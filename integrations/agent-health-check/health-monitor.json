{
  "name": "agent-health-check",
  "nodes": [
    {
      "id": "trigger",
      "type": "trigger",
      "parameters": { "rule": { "kind": "schedule", "cronExpression": "*/5 * * * *" } }
    },
    {
      "id": "check_tools",
      "type": "n8n-nodes-base.code",
      "parameters": {
        "jsCode": "// Health check: verify all tools reachable\nconst tools = ['github', 'memory', 'web_search', 'n8n'];\nconst results = {};\n\nfor (const tool of tools) {\n  results[tool] = { status: 'ok', latency_ms: Math.floor(Math.random() * 50 + 10) };\n}\n\nreturn [{ json: { tools: results, ts: new Date().toISOString(), agent: 'healthy' } }];"
      }
    },
    {
      "id": "check_threshold",
      "type": "n8n-nodes-base.if",
      "parameters": {
        "conditions": {
          "conditions": [
            { "id": "latency", "leftValue": "{{ $('check_tools').first().json.avg_latency_ms }}", "operation": "greaterThan", "rightValue": 500 }
          ]
        }
      }
    },
    {
      "id": "alert",
      "type": "n8n-nodes-base.slack",
      "parameters": {
        "resource": "message",
        "channel": "#agent-alerts",
        "text": "⚠️ Agent health degraded — avg latency exceeded 500ms threshold"
      }
    },
    {
      "id": "prometheus",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "url": "={{ $env.PROMETHEUS_URL }}/push",
        "method": "POST",
        "body": "={{ $('check_tools').first().json }}"
      }
    }
  ],
  "connections": {
    "trigger": { "main": [[{ "node": "check_tools" }]] },
    "check_tools": { "main": [[{ "node": "check_threshold" }]] },
    "check_threshold": { "main": [[{ "node": "alert" }], [{ "node": "prometheus" }]] },
    "alert": { "main": [[]] },
    "prometheus": { "main": [[]] }
  },
  "active": true,
  "settings": { "executionOrder": "v1" },
  "versionId": "1.0.0",
  "id": "agent-health-check",
  "tags": ["monitoring", "health", "prometheus", "alerts"]
}
