{"name":"Backup & DR Pipeline","nodes":[{"id":"cron","name":"Cron (every 6h)","type":"@n8n/n8n-nodes-base.scheduleTrigger","position":[250,300],"parameters":{"rule":{"interval":[{"field":"hours","hoursInterval":6}]}}},{"id":"pg","name":"PostgreSQL Snapshot","type":"@n8n/n8n-nodes-base.postgres","position":[450,200],"parameters":{"operation":"executeQuery","query":"COPY (SELECT * FROM {{ $env.BACKUP_TABLE }}) TO STDOUT WITH CSV HEADER;"}},{"id":"restic","name":"Restic File Backup","type":"@n8n/n8n-nodes-base.code","position":[450,400],"parameters":{"jsCode":"const{execSync}=require('child_process');const d=new Date().toISOString().replace(/[:.]/g,'-');const cmd=`restic -r ${process.env.RESTIC_REPO} backup ${process.env.BACKUP_SOURCE_DIR} --tag auto`;execSync(cmd,{env:{...process.env,RESTIC_PASSWORD:process.env.RESTIC_PASSWORD}});return[{json:{success:true,timestamp:d}}];"}},{"id":"compress","name":"Compress + Encrypt","type":"@n8n/n8n-nodes-base.code","position":[650,300],"parameters":{"jsCode":"const{execSync}=require('child_process');const d=new Date().toISOString().replace(/[:.]/g,'-');execSync(`tar czf - backup.sql | gpg --symmetric --cipher-algo AES256 --output /tmp/backup-${d}.tar.gz.gpg`);return[{json:{file:`/tmp/backup-${d}.tar.gz.gpg`,timestamp:d}}];"}},{"id":"s3","name":"Upload S3 Primary","type":"@n8n/n8n-nodes-base.awsS3","position":[850,200],"parameters":{"operation":"upload","bucket":"={{ $env.S3_BUCKET_PRIMARY }}","fileName":"=backups/{{ $json.timestamp }}/backup.tar.gz.gpg"}},{"id":"dr","name":"Cross-Region DR","type":"@n8n/n8n-nodes-base.awsS3","position":[850,400],"parameters":{"operation":"copy","sourceBucket":"={{ $env.S3_BUCKET_PRIMARY }}","sourceFile":"={{ $json.file }}","destinationBucket":"={{ $env.S3_BUCKET_DR }}"}},{"id":"verify","name":"Restic Verify","type":"@n8n/n8n-nodes-base.code","position":[1050,300],"parameters":{"jsCode":"const{execSync}=require('child_process');try{execSync(`restic -r ${process.env.RESTIC_REPO} check`,{timeout:60000});return[{json:{status:'OK'}}];}catch(e){throw new Error('Backup verification FAILED');}"}},{"id":"alert","name":"Alert on Failure","type":"@n8n/n8n-nodes-base.slack","position":[1250,300],"parameters":{"resource":"message","channel":"={{ $env.SLACK_CHANNEL }}","text":"⚠️ Backup Failed: {{ $json.error }}"}}],"connections":{"cron":{"main":[[{"node":"pg","type":"main","index":0}],[{"node":"restic","type":"main","index":0}]]},"pg":{"main":[[{"node":"compress","type":"main","index":0}]]},"restic":{"main":[[{"node":"compress","type":"main","index":0}]]},"compress":{"main":[[{"node":"s3","type":"main","index":0}],[{"node":"dr","type":"main","index":0}]]},"s3":{"main":[[{"node":"verify","type":"main","index":0}]]},"dr":{"main":[[{"node":"verify","type":"main","index":0}]]}}}
